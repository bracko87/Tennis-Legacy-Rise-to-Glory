{
  "name": "tennis-legacy-desktop",
  "productName": "Tennis Legacy",
  "version": "0.1.0",
  "description": "Desktop test shell for the Tennis Legacy online multiplayer game",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.nextqueststudio.tennislegacy",
    "productName": "Tennis Legacy",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "security.cjs",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TennisLegacy-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "TennisLegacy-${version}-${arch}.${ext}"
    }
  }
}
